---
/**
 * Accessible controls for applying category and publisher filters to the game catalog.
 */

import type { Category, Publisher } from '../types/game';
import Button from './Button.astro';

/** Props for the game catalog filter controls. */
interface Props {
    /** Categories available for multi-select filtering. */
    categories: Category[];
    /** Publishers available for single-select filtering. */
    publishers: Publisher[];
    /** Total number of games before filters are applied. */
    totalGames: number;
}

const { categories, publishers, totalGames } = Astro.props;
---

<section
    class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-6 shadow-lg"
    aria-labelledby="game-filters-heading"
>
    <h2 id="game-filters-heading" class="mb-4 text-xl font-semibold text-slate-100">
        Filter games
    </h2>

    <form data-testid="game-filters" class="space-y-6">
        <div class="grid gap-6 lg:grid-cols-[2fr_1fr]">
            <fieldset>
                <legend class="mb-3 text-sm font-semibold text-slate-200">Categories</legend>
                <div class="flex flex-wrap gap-3">
                    {
                        categories.map((category) => (
                            <label class="inline-flex cursor-pointer items-center gap-2 rounded-lg border border-slate-600 bg-slate-900/60 px-3 py-2 text-sm text-slate-200 transition-colors hover:border-blue-500">
                                <input
                                    type="checkbox"
                                    name="category"
                                    value={category.id}
                                    class="h-4 w-4 rounded border-slate-500 bg-slate-800 text-blue-600 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                                    data-testid={`category-filter-${category.id}`}
                                />
                                {category.name}
                            </label>
                        ))
                    }
                </div>
            </fieldset>

            <div>
                <label for="publisher-filter" class="mb-3 block text-sm font-semibold text-slate-200">
                    Publisher
                </label>
                <select
                    id="publisher-filter"
                    name="publisher"
                    class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                    data-testid="publisher-filter"
                >
                    <option value="">All publishers</option>
                    {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
                </select>
            </div>
        </div>

        <div class="flex flex-wrap items-center gap-3">
            <Button type="submit" size="sm" data-testid="apply-filters">
                Apply filters
            </Button>
            <Button
                type="reset"
                size="sm"
                class="bg-slate-700 hover:bg-slate-600"
                data-testid="clear-filters"
            >
                Clear filters
            </Button>
            <p
                class="text-sm text-slate-300"
                role="status"
                aria-live="polite"
                data-testid="filter-results-status"
            >
                {totalGames} games shown
            </p>
        </div>
    </form>
</section>

<script>
    const form = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
    const grid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
    const emptyState = document.querySelector<HTMLElement>('[data-testid="filtered-empty-state"]');
    const status = document.querySelector<HTMLElement>('[data-testid="filter-results-status"]');

    function applyFilters(): void {
        if (!form || !grid || !emptyState || !status) {
            return;
        }

        const formData = new FormData(form);
        const categoryIds = new Set(formData.getAll('category').map(String));
        const publisherId = String(formData.get('publisher') ?? '');
        let visibleCount = 0;

        for (const card of cards) {
            const matchesCategory =
                categoryIds.size === 0 || categoryIds.has(card.dataset.categoryId ?? '');
            const matchesPublisher =
                publisherId === '' || publisherId === card.dataset.publisherId;
            const isVisible = matchesCategory && matchesPublisher;

            card.hidden = !isVisible;
            if (isVisible) {
                visibleCount += 1;
            }
        }

        grid.hidden = visibleCount === 0;
        emptyState.hidden = visibleCount !== 0;
        status.textContent = `${visibleCount} ${visibleCount === 1 ? 'game' : 'games'} shown`;
    }

    form?.addEventListener('submit', (event) => {
        event.preventDefault();
        applyFilters();
    });

    form?.addEventListener('reset', () => {
        window.requestAnimationFrame(applyFilters);
    });
</script>
