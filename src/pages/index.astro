---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import GameFilters from '../components/GameFilters.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';
import { getAllPublishers } from '../lib/publishers';
import type { Category } from '../types/game';

export const prerender = true;

const db = getDatabase();
const [games, publishers] = await Promise.all([
  getAllGames(db),
  getAllPublishers(db),
]);
const categoriesById = new Map<number, Category>();

for (const game of games) {
  if (game.category) {
    categoriesById.set(game.category.id, game.category);
  }
}

const categories = Array.from(categoriesById.values()).sort((left, right) =>
  left.name.localeCompare(right.name),
);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <GameFilters {categories} {publishers} totalGames={games.length} />

      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
          <div data-testid="filtered-empty-state" hidden>
            <EmptyState text="No games match the selected filters." />
          </div>
        </>
      )}
    </div>
  </div>
</Layout>
